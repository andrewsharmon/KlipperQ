# Arduino UNO Q with a generic Arduino CNC Shield V3.00.
#
# X, Y, and Z are exposed as independent manual steppers. The A socket may
# clone X, Y, or Z using the shield's hardware jumpers. See the independent-A
# notes at the end of this file before selecting the D12/D13 jumper position.
#
# All shield outputs start inactive. The three control inputs and limits use
# MCU pull-ups and expect a switch to ground. ABORT invokes an emergency stop;
# HOLD and RESUME invoke Klipper's pause and resume commands.
#
# The 1 microstep settings below match sockets with no M0/M1/M2 jumpers.
# Change each axis to match its physical jumpers before using distances as
# calibrated units.  The 40 mm rotation distance is only a conservative test
# scale; it is not a machine calibration.

[mcu]
serial: /dev/ttyHS1
baud: 115200

[printer]
kinematics: none
max_velocity: 1
max_accel: 5

[board_pins cnc_shield_v3]
aliases:
    CNC_X_STEP=PB3,       # D2
    CNC_Y_STEP=PB0,       # D3
    CNC_Z_STEP=PA12,      # D4
    CNC_X_DIR=PA11,       # D5
    CNC_Y_DIR=PB1,        # D6
    CNC_Z_DIR=PB2,        # D7
    CNC_ENABLE=PB4,       # D8; shared, active low
    CNC_X_LIMIT=PB8,      # D9; X- and X+ headers are tied together
    CNC_Y_LIMIT=PB9,      # D10; Y- and Y+ headers are tied together
    CNC_Z_LIMIT=PB15,     # D11; Z- and Z+ headers are tied together
    CNC_SPINDLE_ENABLE=PB14,    # D12; also independent A STEP
    CNC_SPINDLE_DIRECTION=PB13, # D13; also independent A DIR
    CNC_ABORT=PA4,        # A0
    CNC_HOLD=PA5,         # A1
    CNC_RESUME=PA6,       # A2
    CNC_COOLANT=PA7,      # A3
    CNC_AUX_A4=PC1,       # A4 / SDA
    CNC_PROBE=PC0         # A5 / SCL

[manual_stepper cnc_x]
step_pin: CNC_X_STEP
dir_pin: CNC_X_DIR
enable_pin: !CNC_ENABLE
endstop_pin: ^!CNC_X_LIMIT
microsteps: 1
rotation_distance: 40
step_pulse_duration: 0.000004
velocity: 1
accel: 5

[manual_stepper cnc_y]
step_pin: CNC_Y_STEP
dir_pin: CNC_Y_DIR
enable_pin: !CNC_ENABLE
endstop_pin: ^!CNC_Y_LIMIT
microsteps: 1
rotation_distance: 40
step_pulse_duration: 0.000004
velocity: 1
accel: 5

[manual_stepper cnc_z]
step_pin: CNC_Z_STEP
dir_pin: CNC_Z_DIR
enable_pin: !CNC_ENABLE
endstop_pin: ^!CNC_Z_LIMIT
microsteps: 1
rotation_distance: 40
step_pulse_duration: 0.000004
velocity: 1
accel: 5

[output_pin cnc_spindle_enable]
pin: CNC_SPINDLE_ENABLE
value: 0
shutdown_value: 0

[output_pin cnc_spindle_direction]
pin: CNC_SPINDLE_DIRECTION
value: 0
shutdown_value: 0

[output_pin cnc_coolant]
pin: CNC_COOLANT
value: 0
shutdown_value: 0

[gcode_button cnc_abort]
pin: ^!CNC_ABORT
press_gcode:
    M112

[gcode_button cnc_hold]
pin: ^!CNC_HOLD
press_gcode:
    PAUSE

[gcode_button cnc_resume]
pin: ^!CNC_RESUME
press_gcode:
    RESUME

[gcode_button cnc_probe]
pin: ^!CNC_PROBE
press_gcode:
    RESPOND TYPE=command MSG="CNC probe triggered"

# Each axis test moves 25 configured full-step equivalents forward and back
# for a typical 200-step motor, then releases the shared driver enable. The
# physical angle depends on the motor and that socket's microstep jumpers.
[gcode_macro CNC_X_TEST]
description: Slowly exercise the CNC Shield X driver in both directions
gcode:
    MANUAL_STEPPER STEPPER=cnc_x ENABLE=1 SET_POSITION=0
    MANUAL_STEPPER STEPPER=cnc_x MOVE=5 SPEED=1 ACCEL=5
    G4 P500
    MANUAL_STEPPER STEPPER=cnc_x MOVE=0 SPEED=1 ACCEL=5
    MANUAL_STEPPER STEPPER=cnc_x ENABLE=0

[gcode_macro CNC_Y_TEST]
description: Slowly exercise the CNC Shield Y driver in both directions
gcode:
    MANUAL_STEPPER STEPPER=cnc_y ENABLE=1 SET_POSITION=0
    MANUAL_STEPPER STEPPER=cnc_y MOVE=5 SPEED=1 ACCEL=5
    G4 P500
    MANUAL_STEPPER STEPPER=cnc_y MOVE=0 SPEED=1 ACCEL=5
    MANUAL_STEPPER STEPPER=cnc_y ENABLE=0

[gcode_macro CNC_Z_TEST]
description: Slowly exercise the CNC Shield Z driver in both directions
gcode:
    MANUAL_STEPPER STEPPER=cnc_z ENABLE=1 SET_POSITION=0
    MANUAL_STEPPER STEPPER=cnc_z MOVE=5 SPEED=1 ACCEL=5
    G4 P500
    MANUAL_STEPPER STEPPER=cnc_z MOVE=0 SPEED=1 ACCEL=5
    MANUAL_STEPPER STEPPER=cnc_z ENABLE=0

[gcode_macro CNC_OUTPUTS_OFF]
description: Disable all steppers, spindle control, and coolant outputs
gcode:
    M84
    SET_PIN PIN=cnc_spindle_enable VALUE=0
    SET_PIN PIN=cnc_spindle_direction VALUE=0
    SET_PIN PIN=cnc_coolant VALUE=0

# Independent A-axis option (mutually exclusive with spindle outputs):
#
# 1. Put the shield's A-axis routing jumpers in the D12/D13 position.
# 2. Remove or comment out both cnc_spindle output_pin sections above.
# 3. Uncomment the section below. D12 is A STEP and D13 is A DIR.
#
# [manual_stepper cnc_a]
# step_pin: CNC_SPINDLE_ENABLE
# dir_pin: CNC_SPINDLE_DIRECTION
# enable_pin: !CNC_ENABLE
# microsteps: 1
# rotation_distance: 40
# step_pulse_duration: 0.000004
# velocity: 1
# accel: 5

[virtual_sdcard]
path: /home/arduino/printer_data/gcodes

[display_status]

[pause_resume]

[respond]
